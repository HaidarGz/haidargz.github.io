---
// A fiber cable crossing the page, printed like a real cable jacket: words and a meter mark every segment.
// The tube's shading and the light running inside it are drawn as SVG.
const { t } = Astro.props;
const meters = Array.from({ length: 8 }, (_, i) => String((i + 1) * 25).padStart(4, '0'));
---
<div class="cable-wrap" aria-hidden="true">
  <div class="cable">
    <svg class="cable-tube" viewBox="0 0 10 10" preserveAspectRatio="none">
      <linearGradient id="cable-shade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#30364f" /><stop offset="0.22" stop-color="#0f1325" /><stop offset="0.62" stop-color="#070914" /><stop offset="1" stop-color="#181d33" />
      </linearGradient>
      <rect width="10" height="10" fill="url(#cable-shade)" />
    </svg>
    <div class="cable-track">
      {[0, 1].map(() => (
        <div class="cable-run">
          {meters.map(m => (
            <span class="cable-seg">
              {t.cable.words.map(w => <span>{w}</span>)}
              <span class="meter">{m} {t.cable.unit}</span>
            </span>
          ))}
        </div>
      ))}
    </div>
    <svg class="cable-glow" viewBox="0 0 100 10" preserveAspectRatio="none">
      <radialGradient id="cable-light"><stop offset="0" stop-color="#ff2d3d" stop-opacity="0.75" /><stop offset="0.55" stop-color="#b9a4ff" stop-opacity="0.22" /><stop offset="1" stop-color="#b9a4ff" stop-opacity="0" /></radialGradient>
      <ellipse cx="50" cy="5" rx="50" ry="8" fill="url(#cable-light)" />
    </svg>
  </div>
</div>
