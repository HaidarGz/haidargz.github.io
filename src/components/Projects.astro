---
// In the field: the crews' photographs lie in a pile of cards cut to the mark's shape. Pressing the pile sends the
// top card away to the bottom and the next one comes up (src/scripts/site.js); --i is each card's place in the pile.
import { Image } from 'astro:assets';
import { PHOTOS } from '../data/site.js';

const { t } = Astro.props;
const files = import.meta.glob('../assets/photos/*.jpg', { eager: true, import: 'default' });
const shots = PHOTOS.map(key => {
  const src = files[`../assets/photos/${key}.jpg`];
  if (!src) throw new Error(`photo ${key}.jpg is missing from src/assets/photos; run npm run assets`);
  return { src, caption: t.projects.captions[key] };
});
---
<section class="section field" id="projects">
  <div class="wrap field-grid">
    <div class="field-copy" data-reveal>
      <h2>{t.projects.title}</h2>
      <p class="lead">{t.projects.intro}</p>
      <p class="field-cap" aria-live="polite" data-field-cap>{shots[0].caption}</p>
    </div>
    <button class="field-stack" type="button" data-field aria-label={t.projects.next}>
      {shots.map((s, i) => (
        <Image src={s.src} alt={s.caption} data-caption={s.caption} style={`--i: ${i}`} widths={[480, 760, 1100]} sizes="(min-width: 900px) 32rem, 72vw" loading="lazy" />
      ))}
    </button>
  </div>
</section>
