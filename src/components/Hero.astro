---
// The live fiber scene fills the first screen: strands fan out of a bundle in the far corner and pulses of light
// run up them (src/scripts/hero.js). The still picture shows until the scene has drawn its first frame.
import { Image } from 'astro:assets';
import bloom from '../../concepts/fiber-bloom.png';

const { t } = Astro.props;
---
<section class="hero" id="top" data-hero>
  <Image class="hero-still" src={bloom} alt="" widths={[960, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="wrap hero-inner">
    <h1>{t.hero.title}</h1>
    <p class="hero-lead" data-hero-fade>{t.hero.lead}</p>
    <div class="hero-cta" data-hero-fade>
      <a class="btn btn-primary" href="#contact">{t.hero.contact}</a>
      <a class="text-link" href="#catalog">{t.hero.catalog}</a>
    </div>
  </div>
</section>

<script>
  // The still picture is the hero until the live fiber scene has drawn its first frame.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector('canvas');
  if (hero && canvas && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = () => import('../scripts/hero.js').then(m => m.startHero(hero, canvas)).catch(() => {});
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 300);
  }
</script>
